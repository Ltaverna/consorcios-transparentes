{
	"$schema": "node_modules/wrangler/config-schema.json",
	// custom_domain: true crea/adjunta panel-consorcio.neuralcore.dev al deployar (zona en la misma cuenta)
	"routes": [{ "pattern": "panel-consorcio.neuralcore.dev", "custom_domain": true }],
	"main": ".open-next/worker.js",
	"name": "panel-consorcio",
	"compatibility_date": "2026-09-01",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	}
}
